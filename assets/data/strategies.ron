// assets/data/strategies.ron
// The scripted commanders' scripts (B1). One entry per *strategy*: a complete
// build order a commander can be constructed from. Promoted out of `units.ron`'s
// `mvp_ai` block — `units.ron` is about units — so the balance sim can hold a
// whole set of them and play them against each other.
//
// SCHEMA NOTE (B1) — build order, thresholds and timings are content; there are
// no AI tuning constants in Rust, and **every duration is counted in
// FixedUpdate ticks (60 Hz), never seconds**.
//   default               — the strategy a match uses when nothing names one.
//                           Must name an entry below, or the content is refused.
//   id                    — how everything else names this strategy (unique).
//   think_interval_ticks  — ticks between two decisions (the commander's APM)
//   worker_target         — workers it keeps mining
//   barracks              — the list of tech openings, in the order it wants
//                           them. Each is (building, at_tick, offset):
//                             building — a placeable (non-victory) building id
//                             at_tick  — earliest tick it may place that one
//                             offset   — how far from its HQ it goes (world
//                                        units; the seeded RNG picks only the
//                                        direction)
//                           A strategy may open several — that is how an army
//                           spans domains (Foundry + Gene-Vats + Aether Spire).
//                           The same building may be opened **more than once**
//                           (B3.5): each entry is its own barracks with its own
//                           at_tick/offset, and every barracks is a production
//                           line of its own, so barracks count is what sets army
//                           throughput (F-028). The five mass probes must all
//                           carry the same count or they stop being comparable
//                           (F-018).
//                           **List only what the commander really places**
//                           (F-035): the tech step places an opening only when
//                           the stockpile covers its cost, and the army step
//                           spends the stockpile first on anything cheaper, so
//                           under B3.5's economy an opening behind the first
//                           few never goes up. Every list below is exactly the
//                           placements the sim makes, in the order it makes
//                           them. Opening reservation is B4's to add.
//   army                  — the repeating build order; **every unit must be
//                           producible by one of the barracks opened above**.
//                           Each order goes to the eligible barracks with the
//                           shallowest queue (ties by entity id).
//   attack_at_army        — combat units it wants before the first wave
//   attack_interval_ticks — ticks between waves
//   attack_spread         — seeded scatter around the enemy HQ per wave
//   queue_depth           — how many army units this strategy allows in
//                           production at one barracks at once. Must be >= 1
//                           (0 would mean "never train"). The commander tops
//                           its queue up by **one per decision**, so a depth of
//                           3 fills over three decisions. Production itself is
//                           still sequential — a barracks builds the head of
//                           its queue — so depth buys the idle ticks between a
//                           unit popping and the next decision, not parallel
//                           production. `1` is the behaviour every match before
//                           B3.5 played, when this cap was a Rust constant.
//
// THE PROBE SET (B1 AC3) — what these entries are *for*. B3 measures the
// counter pentagon with them, so the set is an instrument, not a roster of
// personalities:
//
//   * The five `mass_*` entries hard-commit to one unit each and are
//     **knob-identical**: same think interval, worker target, opening count,
//     opening ticks, offsets, attack threshold, wave interval and spread. Only
//     the barracks they open and the unit they mass differ — with one measured
//     exception. B3.5 scripted three openings each (F-029, F-030), but under
//     its economy only `mass_ripper` (the cheapest unit, 40 Alloy) ever
//     affords a second, at tick ~9 330; no probe ever affords a third (F-035).
//     So the scripts say what the sim does: one barracks for four probes, two
//     for `mass_ripper`, and that opening count is the only knob allowed to
//     differ until B4's opening reservation makes it uniform. If those knobs ever
//     diverge, B3's pentagon assertion measures the knobs instead of the units and the
//     whole instrument is void (F-018). The one asymmetry that stays is a real
//     one from the design: an Aether Spire costs 200 Alloy where a Foundry or
//     Gene-Vats costs 150.
//   * The `synth_*` entries are mixed builds that cross domains — one spans two
//     barracks, one spans all three — so the multi-barracks path is exercised
//     by the shipped content and not only by test fixtures.
//   * `rush` is the all-in: minimum economy, earliest opening, the cheapest
//     unit in the game, attacking with the first body out of the door. (A
//     literal *worker* rush is unbuildable — the Worker has `offense: 0` and no
//     attack cadence or range, so it cannot damage a unit or an HQ. The all-in
//     early rush is the playable form of the same idea.)
//   * `turtle` is its opposite pole: a deep economy, late tech and a big
//     massed force before it commits.
//
// Everything here is priced in the Alloy-only MVP economy (300 starting Alloy;
// Foundry 150, Gene-Vats 150, Aether Spire 200; worker 10, ripper 40,
// sentinel 70, arclight 80, ravager 90, bulwark 110).
//
// TEMPO (B3.5, F-029) — these scripts carry the match-length tuning. The arc
// the brief asks for (5-8 minutes of real fighting) is bought with two knobs
// here and one in `units.ron`: B3.5 scripted **several production lines**
// per strategy, and commits with a **much larger force** (the mass probes at
// 10 units rather than 3), while a worker's load shrank from 10
// Alloy to 2 so the army takes minutes to assemble. The extra lines turned
// out mostly never to be built at that income (F-035) and were removed, so
// what actually carries the tempo is the threshold and the economy; B3.5's
// measurements were all taken on the armies the scripts now describe. The
// poles keep their identity:
// `rush` still opens on tick 0 and attacks with one body, `turtle` still
// masses the largest force in the set before it moves.
(
    default: "mvp",
    strategies: [
        // The MVP opener, number for number as `units.ron`'s `mvp_ai` block had
        // it: one Foundry, fast Sentinel pressure behind an armoured Bulwark.
        // **Left untuned by B3.5's tempo pass on purpose** (F-029): B1 pins
        // this entry field for field as the faithful promotion of `mvp_ai`
        // (`b1_strategies::the_default_strategy_is_the_old_mvp_ai_number_for_number`,
        // and M4c's own tests read it as "the default AI"), so retuning it
        // would change what those assertions mean, not just their values. It
        // therefore plays the new, slower economy on its old tempo — a short
        // opener in a long-game roster, which is a question for the next
        // checkbox, not something to settle by quietly editing a pin.
        (
            id: "mvp",
            think_interval_ticks: 30,
            worker_target: 6,
            barracks: [
                (building: "foundry", at_tick: 300, offset: 130.0),
            ],
            army: [
                (unit: "sentinel", count: 2),   // fast, cheap pressure
                (unit: "bulwark",  count: 1),   // the armoured front
            ],
            attack_at_army: 3,
            attack_interval_ticks: 600,
            attack_spread: 60.0,
            queue_depth: 1,
        ),

        // ---- the five mass-unit probes -------------------------------------
        // Knob-identical by construction; see THE PROBE SET above. Do not tune
        // one of these without tuning all five.

        // Machine / armour. The anvil: slow, heavily armoured, nemesis Ravager.
        (
            id: "mass_bulwark",
            think_interval_ticks: 30,
            worker_target: 6,
            barracks: [
                (building: "foundry", at_tick: 300, offset: 130.0),
            ],
            army: [
                (unit: "bulwark", count: 1),
            ],
            attack_at_army: 10,
            attack_interval_ticks: 300,
            attack_spread: 60.0,
            queue_depth: 1,
        ),
        // Machine / skirmish. Fast, mid-range, nemesis Ripper.
        (
            id: "mass_sentinel",
            think_interval_ticks: 30,
            worker_target: 6,
            barracks: [
                (building: "foundry", at_tick: 300, offset: 130.0),
            ],
            army: [
                (unit: "sentinel", count: 1),
            ],
            attack_at_army: 10,
            attack_interval_ticks: 300,
            attack_spread: 60.0,
            queue_depth: 1,
        ),
        // Flesh / swarm. The cheapest body in the game, nemesis Arclight.
        (
            id: "mass_ripper",
            think_interval_ticks: 30,
            worker_target: 6,
            barracks: [
                (building: "gene_vats", at_tick: 300, offset: 130.0),
                // The one second opening any mass probe really places: the
                // Ripper is the cheapest body, so this is the only probe whose
                // income outruns its spending, and its stockpile reaches 150
                // at tick ~9 330 in every head-to-head long enough (F-035).
                // It makes this probe's opening list the one knob the five do
                // not share; B4's opening reservation should make them
                // identical again.
                (building: "gene_vats", at_tick: 600, offset: 165.0),
            ],
            army: [
                (unit: "ripper", count: 1),
            ],
            attack_at_army: 10,
            attack_interval_ticks: 300,
            attack_spread: 60.0,
            queue_depth: 1,
        ),
        // Flesh / bruiser. Heavy hitter, nemesis Sentinel.
        (
            id: "mass_ravager",
            think_interval_ticks: 30,
            worker_target: 6,
            barracks: [
                (building: "gene_vats", at_tick: 300, offset: 130.0),
            ],
            army: [
                (unit: "ravager", count: 1),
            ],
            attack_at_army: 10,
            attack_interval_ticks: 300,
            attack_spread: 60.0,
            queue_depth: 1,
        ),
        // Energy / artillery. Glass cannon at 120 range, nemesis Bulwark. Pays
        // 200 for its Aether Spire where the other four pay 150 — a designed
        // economic asymmetry, and the only one the five do not share.
        (
            id: "mass_arclight",
            think_interval_ticks: 30,
            worker_target: 6,
            barracks: [
                (building: "aether_spire", at_tick: 300, offset: 130.0),
            ],
            army: [
                (unit: "arclight", count: 1),
            ],
            attack_at_army: 10,
            attack_interval_ticks: 300,
            attack_spread: 60.0,
            queue_depth: 1,
        ),

        // ---- the synthesis builds ------------------------------------------

        // Two domains: Machine + Flesh. Cheap Flesh bodies screening a Machine
        // core — the army a single barracks could never field. One Foundry and
        // one Gene-Vats: B3.5 scripted a second of each, which never went up
        // (F-035).
        (
            id: "synth_steel_flesh",
            think_interval_ticks: 30,
            worker_target: 8,
            barracks: [
                (building: "foundry",   at_tick: 300,  offset: 130.0),
                (building: "gene_vats", at_tick: 900,  offset: 160.0),
            ],
            army: [
                (unit: "sentinel", count: 1),
                (unit: "ripper",   count: 2),
                (unit: "bulwark",  count: 1),
            ],
            attack_at_army: 9,
            attack_interval_ticks: 300,
            attack_spread: 70.0,
            queue_depth: 1,
        ),
        // All three domains: a Ripper screen, a Sentinel, an Arclight behind.
        // The widest opening in the set — 650 Alloy of tech before a shot is
        // fired — so it also probes whether spreading tech is affordable at all.
        // The only multi-opening script whose every opening goes up (F-035).
        // Listed in the order the sim places them: the second Gene-Vats
        // (150) is affordable at tick ~5 190, the Aether Spire (200) not until
        // ~7 740, so the Gene-Vats goes up first despite its later at_tick.
        (
            id: "synth_triad",
            think_interval_ticks: 30,
            worker_target: 8,
            barracks: [
                (building: "foundry",      at_tick: 300,  offset: 130.0),
                (building: "gene_vats",    at_tick: 900,  offset: 160.0),
                (building: "gene_vats",    at_tick: 1800, offset: 225.0),
                (building: "aether_spire", at_tick: 1500, offset: 190.0),
            ],
            army: [
                (unit: "sentinel", count: 1),
                (unit: "ripper",   count: 1),
                (unit: "arclight", count: 1),
            ],
            attack_at_army: 9,
            attack_interval_ticks: 300,
            attack_spread: 70.0,
            queue_depth: 1,
        ),

        // ---- the two poles --------------------------------------------------

        // All-in. No economy past the starting three workers, a Gene-Vats on
        // the first decision, and the first Ripper out of it goes straight at
        // the enemy HQ; waves every 120 ticks after that.
        (
            id: "rush",
            think_interval_ticks: 15,
            worker_target: 1,
            barracks: [
                (building: "gene_vats", at_tick: 0, offset: 90.0),
            ],
            army: [
                (unit: "ripper", count: 1),
            ],
            attack_at_army: 1,
            attack_interval_ticks: 120,
            attack_spread: 40.0,
            queue_depth: 1,
        ),
        // The opposite pole: twelve workers, late tech on three lines (a fourth
        // was scripted in B3.5 and never went up, F-035), and
        // nothing leaves home until the biggest force in the set exists.
        (
            id: "turtle",
            think_interval_ticks: 30,
            worker_target: 12,
            barracks: [
                (building: "foundry",   at_tick: 600,  offset: 110.0),
                (building: "gene_vats", at_tick: 1200, offset: 140.0),
                (building: "foundry",   at_tick: 1800, offset: 175.0),
            ],
            army: [
                (unit: "sentinel", count: 1),
                (unit: "ripper",   count: 2),
                (unit: "bulwark",  count: 1),
            ],
            // 26, not 15 (F-036): at 15 it committed at tick 13 470, before
            // four other strategies (mass_bulwark last at 18 750), so it was
            // not the late pole any more. 26 commits at 19 320, the smallest
            // value measured with a margin (24 clears by only 390 ticks).
            attack_at_army: 26,
            attack_interval_ticks: 600,
            attack_spread: 80.0,
            queue_depth: 1,
        ),
    ],
)
