// assets/data/units.ron
// Unit definitions consumed by the sim at startup (M4a deserializes these into
// Rust structs via `sim::content`). Stats are on a 1-10 design scale; the
// balance sim tunes the real numbers later.
// `nemesis` = the one prey this unit gets the bonus against.
//
// SCHEMA NOTE (M4a) — MVP is Alloy-only as the single currency funding all five
// combat units + the Worker (MVP_PLAN.md). The per-domain `cost` fields below
// are the *post-MVP* target and are kept intact; the `mvp_*` fields are what the
// MVP sim actually charges and uses:
//   mvp_kind         — silhouette class (Worker/Soldier/Scout), sim data
//   mvp_alloy_cost   — Alloy deducted once when production is ordered
//   mvp_train_ticks  — FixedUpdate ticks (60 Hz) to finish the unit
//   mvp_carry_capacity / mvp_gather_ticks — worker gather loop (load size, and
//                       ticks spent harvesting one load at a deposit)
//                       `mvp_carry_capacity` is the **economy clock**: income
//                       is loads/second times this, and an army costs a fixed
//                       number of Alloy, so it sets how many minutes a force
//                       takes to assemble. B3.5's tempo tuning (F-029) cut it
//                       from 10 to 2 — a 5x slower build-up — which is how the
//                       decided-match median moved from 1:16 into the brief's
//                       5-8 minute band without anyone's army getting smaller.
// `mvp_buildings` is the building cost table (HQ + the three barracks); each
// lists the unit ids it can produce.
//
// SCHEMA NOTE (M4b) — combat. The 1-10 design stats are *design* numbers; the
// sim needs real ones, so `mvp_combat` below carries the scaling (data, not Rust
// constants) and each unit carries its own engagement numbers:
//   mvp_attack_ticks — FixedUpdate ticks between two hits (a cadence, never
//                      seconds; the sim counts ticks). 0 for non-combatants.
//   mvp_attack_range — world-unit radius within which this unit can hit. 0 for
//                      non-combatants (offense 0 ⇒ both must be 0).
// Derived, per hit, in integer arithmetic only:
//   HP pool  = defense * mvp_combat.hp_per_defense
//   damage   = offense * mvp_combat.damage_per_offense
//   mitigate = defender.armor * mvp_combat.mitigation_per_armor   (flat, per hit)
//   speed    = speed * mvp_combat.speed_per_point                 (world units/s)
// `speed_per_point` is 36.0 because the retired M4a global constant (180 u/s)
// was exactly the Worker's `speed: 5` — per-unit data that keeps M4a's timings.
// Nemesis (`nemesis_bonus`) is applied as an integer per-mille multiplier:
// damage = floor(base * round(damage_mult * 1000) / 1000), armor skipped. The
// float is converted once at load; no float ever enters per-hit damage, so the
// result is bit-identical on every machine.
(
    workers: [
        (
            id: "worker",
            name: "Worker",
            source: "hq",
            cost: (resource: "alloy", amount: 10),
            mvp_kind: Worker,
            mvp_alloy_cost: 10,
            mvp_train_ticks: 600,
            mvp_carry_capacity: 2,   // B3.5 tempo (F-029): was 10
            mvp_gather_ticks: 90,
            mvp_attack_ticks: 0, mvp_attack_range: 0.0,   // non-combatant
            speed: 5, offense: 0, defense: 3, armor: 0,
            gathers: true,
            builds: true,
        ),
    ],
    combat: [
        (
            id: "bulwark",   name: "Bulwark",   barracks: "foundry",      // Machine
            cost: (resource: "alloy",   amount: 95),
            mvp_kind: Soldier,
            mvp_alloy_cost: 95, mvp_train_ticks: 1300,
            mvp_attack_ticks: 90, mvp_attack_range: 48.0,
            speed: 2, offense: 4, defense: 9, armor: 9, nemesis: "ravager",
        ),
        (
            id: "sentinel",  name: "Sentinel",  barracks: "foundry",      // Machine
            cost: (resource: "alloy",   amount: 90),
            mvp_kind: Scout,
            mvp_alloy_cost: 90, mvp_train_ticks: 900,
            mvp_attack_ticks: 60, mvp_attack_range: 60.0,
            speed: 7, offense: 6, defense: 5, armor: 5, nemesis: "ripper",
        ),
        (
            id: "ripper",    name: "Ripper",    barracks: "gene_vats",    // Flesh
            cost: (resource: "biomass", amount: 40),
            mvp_kind: Scout,
            mvp_alloy_cost: 40, mvp_train_ticks: 1040,
            mvp_attack_ticks: 70, mvp_attack_range: 40.0,
            speed: 9, offense: 6, defense: 3, armor: 1, nemesis: "arclight",
        ),
        (
            id: "ravager",   name: "Ravager",   barracks: "gene_vats",    // Flesh
            cost: (resource: "biomass", amount: 95),
            mvp_kind: Soldier,
            mvp_alloy_cost: 95, mvp_train_ticks: 1100,
            mvp_attack_ticks: 75, mvp_attack_range: 44.0,
            speed: 4, offense: 7, defense: 8, armor: 3, nemesis: "sentinel",
        ),
        (
            id: "arclight",  name: "Arclight",  barracks: "aether_spire", // Energy
            cost: (resource: "aether",  amount: 65),
            mvp_kind: Soldier,
            mvp_alloy_cost: 65, mvp_train_ticks: 1080,
            mvp_attack_ticks: 100, mvp_attack_range: 120.0,   // the ranged one
            speed: 5, offense: 9, defense: 4, armor: 2, nemesis: "bulwark",
        ),
    ],
    // MVP building cost table (Alloy). The HQ exists at match start; the three
    // barracks are placeable and each trains its own units.
    mvp_buildings: [
        // `victory: true` marks the building whose loss ends the match (M4c);
        // mvp_defense / mvp_armor put buildings on the same 1-10 design scale as
        // units (pool = mvp_defense * mvp_combat.building_hp_per_defense).
        (id: "hq",           name: "HQ",           alloy_cost: 400, produces: ["worker"], dropoff: true, victory: true, mvp_defense: 10, mvp_armor: 4),
        (id: "foundry",      name: "Foundry",      alloy_cost: 150, produces: ["bulwark", "sentinel"], mvp_defense: 6, mvp_armor: 3),
        (id: "gene_vats",    name: "Gene-Vats",    alloy_cost: 150, produces: ["ripper", "ravager"], mvp_defense: 6, mvp_armor: 3),
        (id: "aether_spire", name: "Aether Spire", alloy_cost: 200, produces: ["arclight"], mvp_defense: 5, mvp_armor: 2),
    ],
    // M4b: how the 1-10 design stats become sim numbers. Change balance here,
    // never in Rust.
    mvp_combat: (
        hp_per_defense: 20,        // Defense -> HP pool
        damage_per_offense: 5,     // Offense -> damage per hit
        mitigation_per_armor: 2,   // Armor  -> flat mitigation per hit
        speed_per_point: 36.0,     // Speed  -> world units per second
        building_hp_per_defense: 840,   // buildings' Defense -> HP pool (a base
                                       // outlasts a soldier without leaving the
                                       // 1-10 design scale)
        max_stat: 10,              // the design scale is 1-10; stats above this
                                   // are a load error (the per-hit arithmetic is
                                   // u32 and must be able to represent them)
        engage_range: 220.0,       // radius in which an idle unit picks a fight
        pursue_range: 400.0,       // leash: how far it will chase before giving
                                   // up (>= engage_range, because walking around
                                   // an obstacle legitimately opens the gap)
        attack_move_range: 220.0,  // radius in which an attack-mover (a wave
                                   // whose strategy's wave_order is attack_move)
                                   // acquires a target; attack-movers only, and
                                   // every strategy ships `attack_move` (F-049).
                                   // longest unit reach <= this <= pursue_range
                                   // (B4, F-048)
    ),
    // Applied when attacker.nemesis == defender.id
    nemesis_bonus: (
        damage_mult: 2.0,   // double damage vs the one prey (held as 2000
                            // per-mille; +30% until F-049)
        ignore_armor: true,
    ),

    // ---- C1: the campaign battle layer ----------------------------------
    // SCHEMA NOTE (C1) — Generals. One General type per nation (DESIGN_BRIEF
    // "Campaign battles"). A General is a unit on the same 4-stat model, but
    // its own list: never trained, never in an AI wave, no nemesis (a
    // `nemesis:` here is a load error). Read only by a campaign battle; a
    // skirmish never fields one. `mvp_attack_ticks` / `mvp_attack_range` as
    // for every unit (a General fights, so both are required and positive).
    // `aura` (C1 AC3): friendly non-General units within `radius` get the
    // `modifiers` — `add` design points to Offense / Defense / Armor / Speed /
    // Regen, or `mul` the attack interval (AttackTicks; < 1 is faster).
    // Defense scales incoming damage by defense / (defense + add); Regen heals
    // `add` HP every mvp_battle.regen_interval_ticks. `scaling: Flat` applies
    // them as written; `PerDistinctDomain(max: n)` (the synthesists) multiplies
    // them by the number of distinct domains among the units in the radius, up
    // to n. There is no Nemesis stat: an aura never touches the hard counters.
    // Different kinds (General types) stack; the same kind does not — a unit
    // takes the strongest.
    generals: [
        (id: "general_synthesis", name: "Heir of Vael",  mvp_kind: Soldier, mvp_attack_ticks: 80, mvp_attack_range: 48.0, speed: 5, offense: 5, defense: 6, armor: 4,
         aura: (radius: 220.0, modifiers: [(stat: Offense, add: 1), (stat: Armor, add: 1)], scaling: PerDistinctDomain(max: 3))),
        (id: "general_bulwark",   name: "Forge-Marshal", mvp_kind: Soldier, mvp_attack_ticks: 80, mvp_attack_range: 48.0, speed: 3, offense: 4, defense: 8, armor: 6,
         aura: (radius: 200.0, modifiers: [(stat: Defense, add: 2), (stat: Armor, add: 2)], scaling: Flat)),
        (id: "general_frenzy",    name: "Brood-Mother",  mvp_kind: Soldier, mvp_attack_ticks: 80, mvp_attack_range: 48.0, speed: 7, offense: 6, defense: 5, armor: 2,
         aura: (radius: 200.0, modifiers: [(stat: AttackTicks, mul: 0.8)], scaling: Flat)),
        (id: "general_focus",     name: "Ley-Warden",    mvp_kind: Soldier, mvp_attack_ticks: 80, mvp_attack_range: 48.0, speed: 5, offense: 7, defense: 4, armor: 2,
         aura: (radius: 240.0, modifiers: [(stat: Offense, add: 2)], scaling: Flat)),
        (id: "general_logistics", name: "Quartermaster", mvp_kind: Soldier, mvp_attack_ticks: 80, mvp_attack_range: 48.0, speed: 8, offense: 3, defense: 5, armor: 3,
         aura: (radius: 260.0, modifiers: [(stat: Speed, add: 2)], scaling: Flat)),
        (id: "general_endurance", name: "Ash-Keeper",    mvp_kind: Soldier, mvp_attack_ticks: 80, mvp_attack_range: 48.0, speed: 4, offense: 4, defense: 7, armor: 4,
         aura: (radius: 200.0, modifiers: [(stat: Regen, add: 1)], scaling: Flat)),
    ],
    // Campaign-battle layout (world units), relative to each side's base.
    mvp_battle: (
        general_front: 80.0,       // a side's Generals stand this far in front of its base
        formation_spacing: 30.0,   // neighbours in a starting formation
        regen_interval_ticks: 60,  // a Regen aura heals once a second
        entry_edge_offset: 150.0,  // a side's entry edge runs this far behind its base;
                                   // a retreat (Order::Retreat) leaves the field there
        building_spacing: 160.0,   // a roster's buildings, in a line across the base
        formation_rank: 8,         // a roster's units per rank, behind the Generals
    ),
    // The AI's battle behaviour around its General (C1).
    mvp_general_ai: (
        guard_radius: 150.0,       // an enemy fighter this near a General pulls the army onto him
        retreat_at_army_lost: 0.6, // retreat once 60% of the most fighters it has fielded are lost
    ),
)
