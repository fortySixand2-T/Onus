// assets/data/units.ron
// Unit definitions consumed by the sim at startup (M4a deserializes these into
// Rust structs via `sim::content`). Stats are on a 1-10 design scale; the
// balance sim tunes the real numbers later.
// `nemesis` = the one prey this unit gets the bonus against.
//
// SCHEMA NOTE (M4a) — MVP is Alloy-only as the single currency funding all five
// combat units + the Worker (MVP_PLAN.md). The per-domain `cost` fields below
// are the *post-MVP* target and are kept intact; the `mvp_*` fields are what the
// MVP sim actually charges and uses:
//   mvp_kind         — silhouette class (Worker/Soldier/Scout), sim data
//   mvp_alloy_cost   — Alloy deducted once when production is ordered
//   mvp_train_ticks  — FixedUpdate ticks (60 Hz) to finish the unit
//   mvp_carry_capacity / mvp_gather_ticks — worker gather loop (load size, and
//                       ticks spent harvesting one load at a deposit)
// `mvp_buildings` is the building cost table (HQ + the three barracks); each
// lists the unit ids it can produce.
//
// SCHEMA NOTE (M4b) — combat. The 1-10 design stats are *design* numbers; the
// sim needs real ones, so `mvp_combat` below carries the scaling (data, not Rust
// constants) and each unit carries its own engagement numbers:
//   mvp_attack_ticks — FixedUpdate ticks between two hits (a cadence, never
//                      seconds; the sim counts ticks). 0 for non-combatants.
//   mvp_attack_range — world-unit radius within which this unit can hit. 0 for
//                      non-combatants (offense 0 ⇒ both must be 0).
// Derived, per hit, in integer arithmetic only:
//   HP pool  = defense * mvp_combat.hp_per_defense
//   damage   = offense * mvp_combat.damage_per_offense
//   mitigate = defender.armor * mvp_combat.mitigation_per_armor   (flat, per hit)
//   speed    = speed * mvp_combat.speed_per_point                 (world units/s)
// `speed_per_point` is 36.0 because the retired M4a global constant (180 u/s)
// was exactly the Worker's `speed: 5` — per-unit data that keeps M4a's timings.
// Nemesis (`nemesis_bonus`) is applied as an integer per-mille multiplier:
// damage = floor(base * round(damage_mult * 1000) / 1000), armor skipped. The
// float is converted once at load; no float ever enters per-hit damage, so the
// result is bit-identical on every machine.
(
    workers: [
        (
            id: "worker",
            name: "Worker",
            source: "hq",
            cost: (resource: "alloy", amount: 10),
            mvp_kind: Worker,
            mvp_alloy_cost: 10,
            mvp_train_ticks: 600,
            mvp_carry_capacity: 10,
            mvp_gather_ticks: 90,
            mvp_attack_ticks: 0, mvp_attack_range: 0.0,   // non-combatant
            speed: 5, offense: 0, defense: 3, armor: 0,
            gathers: true,
            builds: true,
        ),
    ],
    combat: [
        (
            id: "bulwark",   name: "Bulwark",   barracks: "foundry",      // Machine
            cost: (resource: "alloy",   amount: 110),
            mvp_kind: Soldier,
            mvp_alloy_cost: 110, mvp_train_ticks: 1500,
            mvp_attack_ticks: 90, mvp_attack_range: 48.0,
            speed: 2, offense: 4, defense: 9, armor: 9, nemesis: "ravager",
        ),
        (
            id: "sentinel",  name: "Sentinel",  barracks: "foundry",      // Machine
            cost: (resource: "alloy",   amount: 70),
            mvp_kind: Scout,
            mvp_alloy_cost: 70, mvp_train_ticks: 900,
            mvp_attack_ticks: 60, mvp_attack_range: 60.0,
            speed: 7, offense: 6, defense: 5, armor: 5, nemesis: "ripper",
        ),
        (
            id: "ripper",    name: "Ripper",    barracks: "gene_vats",    // Flesh
            cost: (resource: "biomass", amount: 40),
            mvp_kind: Scout,
            mvp_alloy_cost: 40, mvp_train_ticks: 720,
            mvp_attack_ticks: 40, mvp_attack_range: 40.0,
            speed: 9, offense: 6, defense: 3, armor: 1, nemesis: "arclight",
        ),
        (
            id: "ravager",   name: "Ravager",   barracks: "gene_vats",    // Flesh
            cost: (resource: "biomass", amount: 90),
            mvp_kind: Soldier,
            mvp_alloy_cost: 90, mvp_train_ticks: 1200,
            mvp_attack_ticks: 75, mvp_attack_range: 44.0,
            speed: 4, offense: 7, defense: 8, armor: 4, nemesis: "sentinel",
        ),
        (
            id: "arclight",  name: "Arclight",  barracks: "aether_spire", // Energy
            cost: (resource: "aether",  amount: 80),
            mvp_kind: Soldier,
            mvp_alloy_cost: 80, mvp_train_ticks: 1080,
            mvp_attack_ticks: 100, mvp_attack_range: 120.0,   // the ranged one
            speed: 5, offense: 9, defense: 2, armor: 2, nemesis: "bulwark",
        ),
    ],
    // MVP building cost table (Alloy). The HQ exists at match start; the three
    // barracks are placeable and each trains its own units.
    mvp_buildings: [
        (id: "hq",           name: "HQ",           alloy_cost: 400, produces: ["worker"], dropoff: true, victory: true),
        (id: "foundry",      name: "Foundry",      alloy_cost: 150, produces: ["bulwark", "sentinel"]),
        (id: "gene_vats",    name: "Gene-Vats",    alloy_cost: 150, produces: ["ripper", "ravager"]),
        (id: "aether_spire", name: "Aether Spire", alloy_cost: 200, produces: ["arclight"]),
    ],
    // M4b: how the 1-10 design stats become sim numbers. Change balance here,
    // never in Rust.
    mvp_combat: (
        hp_per_defense: 20,        // Defense -> HP pool
        damage_per_offense: 5,     // Offense -> damage per hit
        mitigation_per_armor: 2,   // Armor  -> flat mitigation per hit
        speed_per_point: 36.0,     // Speed  -> world units per second
        max_stat: 10,              // the design scale is 1-10; stats above this
                                   // are a load error (the per-hit arithmetic is
                                   // u32 and must be able to represent them)
        engage_range: 220.0,       // radius in which an idle unit picks a fight
        pursue_range: 400.0,       // leash: how far it will chase before giving
                                   // up (>= engage_range, because walking around
                                   // an obstacle legitimately opens the gap)
    ),
    // M4c: the scripted AI's whole script. Build order, thresholds and timings
    // are content — there are no AI tuning constants in Rust — and every
    // duration is counted in FixedUpdate ticks (60 Hz), never seconds.
    //   think_interval_ticks  — ticks between two decisions (the commander's APM)
    //   worker_target         — workers it keeps mining
    //   barracks / barracks_at_tick / barracks_offset
    //                         — which barracks it opens with, the earliest tick
    //                           it places one, and how far from its HQ (the
    //                           seeded RNG picks only the direction)
    //   army                  — the repeating build order; every unit must be
    //                           producible by `barracks`
    //   attack_at_army        — combat units it wants before the first wave
    //   attack_interval_ticks — ticks between waves
    //   attack_spread         — seeded scatter around the enemy HQ per wave
    mvp_ai: (
        think_interval_ticks: 30,
        worker_target: 6,
        barracks: "foundry",
        barracks_at_tick: 300,
        barracks_offset: 130.0,
        army: [
            (unit: "sentinel", count: 2),   // fast, cheap pressure
            (unit: "bulwark",  count: 1),   // the armoured front
        ],
        attack_at_army: 3,
        attack_interval_ticks: 600,
        attack_spread: 60.0,
    ),
    // Applied when attacker.nemesis == defender.id
    nemesis_bonus: (
        damage_mult: 1.3,   // +30% vs the one prey (held as 1300 per-mille)
        ignore_armor: true,
    ),
)
