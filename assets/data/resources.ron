// assets/data/resources.ron
// One resource per domain (single-tier mapping).
// MVP scope guard: the first playable uses `alloy` only.
(
    resources: [
        (
            id: "alloy",   name: "Alloy",   domain: "machine",
            building: "foundry",
            acquisition: Mined,       // finite deposits; workers harvest and return
            powers: ["bulwark", "sentinel"],
        ),
        (
            id: "biomass", name: "Biomass", domain: "flesh",
            building: "gene_vats",
            acquisition: Grown,       // passive generation, storage-capped
            powers: ["ripper", "ravager"],
        ),
        (
            id: "aether",  name: "Aether",  domain: "energy",
            building: "aether_spire",
            acquisition: Channeled,   // scarce, contested ley-wells you must hold
            powers: ["arclight"],
        ),
    ],
    mvp_active: ["alloy"],   // first playable uses Alloy only

    // SCHEMA NOTE (M4a): MVP economy tunables the sim reads instead of
    // hardcoding constants. `currency` is the single MVP resource; the ranges
    // are world-unit radii for "close enough to harvest / to deposit".
    mvp_economy: (
        currency: "alloy",
        starting_alloy: 300,   // each faction's Alloy at match start
        gather_range: 40.0,
        deposit_range: 48.0,
    ),

    // SCHEMA NOTE (C3): the three-resource economy, opt-in per match
    // (MatchSettings::economy, the client's pick). An Alloy-only match never
    // reads this block. In a three-resource match units are paid in their
    // `cost` resource (units.ron) and buildings stay priced in Alloy.
    //   starting_biomass / starting_aether — each side's banks at match start
    //   growth — Biomass (Grown): every `interval_ticks` ticks each standing
    //     source building grows `per_interval` Biomass for its side, up to the
    //     side's storage cap, the sum of its standing sources' `storage`.
    three_resource: (
        starting_biomass: 100,
        starting_aether: 0,
        growth: (
            interval_ticks: 40,   // a landing every 2/3 s at 60 Hz (F-085: x1.5 pace)
            sources: [
                (building: "hq",        per_interval: 1, storage: 200),   // a floor every side has
                (building: "gene_vats", per_interval: 2, storage: 250),   // build Vats to grow more
            ],
        ),
        //   wells — Aether (Channeled): ley-wells placed relative to the two HQs,
        //     `along` the line from side A's HQ to side B's (0..1) and `side`
        //     world units across it (left of A->B). Keep the layout
        //     point-symmetric ((along, side) and (1 - along, -side)) so neither
        //     side has the better map. A side holds a well while one of its
        //     units or buildings is within `hold_radius` and no enemy's is; a
        //     held well banks `per_interval` Aether every `interval_ticks` of
        //     holding (paused while empty or contested, restarted when the
        //     holder changes).
        wells: (
            hold_radius: 110.0,
            interval_ticks: 40,
            per_interval: 2,
            sites: [
                (along: 0.2, side: -220.0),   // side A's home well
                (along: 0.8, side: 220.0),    // side B's home well
                (along: 0.5, side: 0.0),      // the contested middle
            ],
        ),
        //   ai — the scripted AI's well detachments: `keepers` gatherers kept
        //     standing on its home well (the well nearest its HQ), `guards`
        //     fighters sent to contest the nearest other well that is not the
        //     enemy's home (the middle), and back to the home well while an
        //     enemy is on it. Both are taken from its lowest-entity units.
        ai: (keepers: 1, guards: 2),
    ),
)
